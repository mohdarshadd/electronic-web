# Cashfree Payment Gateway (India)
# Get sandbox keys for free at https://merchant.cashfree.com/registration
# For real payments, set CASHFREE_ENV=PROD and use your production keys.
# Leave unset to run the site in demo-checkout mode (payments auto-succeed).

CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=SANDBOX

# Admin panel (/admin) — any password you choose. Unset = admin panel disabled.
ADMIN_PASSWORD=